# 请勿提交真实密钥。默认只调用 DeepSeek；不需要 Tavily 或 LangSmith。
DEEPSEEK_API_KEY=
MODEL=deepseek/deepseek-chat
# 可选：DeepSeek 官方或用户指定的兼容服务地址
# DEEPSEEK_API_BASE=https://api.deepseek.com
# 或改为 MODEL=openai/你的模型名，并设置下面两项：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# 数据库路径：相对路径以项目目录为基准
TICKET_DB_PATH=data/tickets.sqlite3
LANGSMITH_TRACING=false
# HTTP 工作台地址；正式域名必须使用 https，服务会自动启用 Secure Cookie。
APP_ORIGIN=http://127.0.0.1:8000
# 可选：按你实际使用服务的单价填写，币种自行统一；未设置时成本显示未知
# INPUT_PRICE_PER_MILLION=
# OUTPUT_PRICE_PER_MILLION=
# HTTP 智能对话限制；按 UTC 自然日计数，重启服务不会清零。
DEMO_MODEL_ENABLED=true
DEMO_MAX_CONCURRENT=2
DEMO_USER_RUNS_PER_MINUTE=6
DEMO_USER_DAILY_TOKENS=100000
DEMO_DAILY_TOKENS=500000
# 可选金额门禁；启用前必须填写上述两项同币种模型单价。
# DEMO_DAILY_COST_LIMIT=
